# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=postgres

# Angel One SmartAPI
ANGEL_ONE_API_KEY=your_angel_one_api_key
ANGEL_ONE_API_SECRET=your_angel_one_api_secret
ANGEL_ONE_ACCESS_TOKEN=your_access_token
ANGEL_ONE_FEED_TOKEN=your_feed_token
ANGEL_ONE_CLIENT_ID=your_angel_one_client_code
ANGEL_ONE_PASSWORD=your_angel_one_password_or_pin
ANGEL_ONE_TOTP_SECRET=your_angel_one_totp_secret

# TrueData
TRUEDATA_USER=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password

# Trading Parameters
INITIAL_CAPITAL=50000
RISK_PER_TRADE=0.01
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS_PCT=0.05
SCORE_THRESHOLD=0.6

# Broker Execution (OrderManager circuit breaker — absolute rupees, not a %)
MAX_DAILY_LOSS=-5000

# Model
MODEL_DIR=models/saved
MACRO_MODEL_PATH=models/saved/macro_model.pkl
MICRO_MODEL_PATH=models/saved/micro_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Strike selection: ATM | ITM1 | ITM2 | OTM1 ...  (CALL ITM = lower strike)
STRIKE_SELECTION=ATM

# Scalp strategy — "win at max, lose at min"
SCALP_MODE=1
SCALP_LOTS=1                 # fixed lots per entry
SCALP_MAX_TRADES_DAY=15      # daily auto-entry cap
SCALP_SCORE_THRESHOLD=0.62   # entry score bar (other quality gates still apply)
SCALP_TARGET_RUPEES=1000     # take profit at +Rs.1000
SCALP_LOCK_RUPEES=600        # once +Rs.600 seen, ratchet SL so it can't exit below +Rs.600
SCALP_MAX_LOSS_RUPEES=600    # hard rupee stop
SCALP_SL_PCT=0.08            # % backstop stop (tighter of this and the rupee stop wins)
SCALP_BE_TRIGGER_PCT=0.04    # +4% -> SL to entry
SCALP_TIME_STOP_MIN=12       # not in profit within 12 min -> exit at market
